          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "destination",
          "summary"
        ],
        "additionalProperties": false
      }
    },
    {
      "effect": "deny",
      "name": "summary.save_draft",
      "subjects": {
        "groups": ["support-agents"],
        "principals": []
      },
      "arguments_schema": {}
    },
    {
      "effect": "deny",
      "name": "email.send",
      "subjects": {
        "groups": ["support-agents", "support-managers"],
        "principals": ["local-agent"]
      },
      "arguments_schema": {}
    }
  ]
